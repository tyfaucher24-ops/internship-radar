  "_readme": "V12: specialised titles inside a broad field and the majors they normally draw from (typical expectation, from the title wording only). A profile whose major isn't listed gets a lower Fit for that title, never a hard block.",
  "rules": [
   {
    "re": "actuar",
    "majors": "math|actuar|statistic|economics|data",
    "label": "actuarial roles usually want math, statistics or actuarial science majors"
   },
   {
    "re": "\\b(it|technology|cyber|software|systems?|data|engineering)\\b",
    "majors": "computer|information|data|software|engineering|math|statistic|cyber",
    "label": "technology roles usually want CS, IS or data majors"
   },
   {
    "re": "\\b(audit|tax|accounting|assurance)\\b",
    "majors": "accounting|finance",
    "label": "audit and tax roles usually want accounting majors"
   },
   {
    "re": "quant|quantitative|trading|strats",
    "majors": "math|computer|physics|statistic|engineering|economics|financial engineering",
    "label": "quant roles usually want math, CS or physics majors"
   },
   {
    "re": "\\b(legal|paralegal|law)\\b",
    "majors": "legal|law|political|english|history|philosophy|criminal",
    "label": "legal roles usually want pre-law style majors"
   }
  ]
